                "$ref": "#/components/schemas/FaceParsingForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Indexed PNG label map and stable BiSeNet region evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaceParsingResponse"
                }
              }
            }
          }
        }
      }
    }
  },
