          {
            "$ref": "#/components/parameters/SubjectSegmentationSoftMaskCapability"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/SubjectSegmentationForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded native-resolution Gray8 probability PNG",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubjectSegmentationSoftMaskResponse"
                }
              }
            }
          }
        }
      }
    }
  },
