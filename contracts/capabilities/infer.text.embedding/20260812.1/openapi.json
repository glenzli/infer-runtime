{
  "openapi": "3.1.0",
  "info": {
    "title": "Infer Runtime capability infer.text.embedding",
    "version": "20260812.1",
    "description": "Immutable capability-scoped wire schema. Authentication and Consumer Core negotiation are inherited from the Core contract."
  },
  "x-infer-capability-contract": "infer.text.embedding@20260812.1",
