{
  "openapi": "3.1.0",
  "info": {
    "title": "Infer Runtime capability infer.vision.semantic-grounding",
    "version": "20260830.1",
    "description": "Immutable capability-scoped wire schema. Authentication and Consumer Core negotiation are inherited from the Core contract."
  },
  "x-infer-capability-contract": "infer.vision.semantic-grounding@20260830.1",
  "paths": {
    "/infer/v1/vision/semantic-groundings": {
      "post": {
        "operationId": "createSemanticGrounding",
        "x-infer-stability": "experimental",
        "description": "Local-only open-vocabulary localization. Returns a bounded set of normalized candidate boxes for Consumer-owned mask refinement and composition.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SemanticGroundingCapability"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/SemanticGroundingForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded normalized semantic region candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SemanticGroundingResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "SemanticGroundingCapability": {
        "name": "Infer-Capability-Contract",
        "in": "header",
        "required": true,
        "schema": {
          "const": "infer.vision.semantic-grounding@20260830.1"
        }
      }
    },
    "schemas": {
      "ImageGeometry": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "width",
          "height",
          "orientation"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "orientation": {
            "const": "display_pixels_orientation_normalized"
          }
        }
      },
      "SemanticGroundingForm": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VisionImageFormBase"
          },
          {
            "type": "object",
            "required": [
              "image_orientation",
              "query",
              "query_revision",
              "maximum_regions",
              "score_threshold"
            ],
            "properties": {
              "model": {
                "const": "vision.ground_semantics"
              },
              "image_orientation": {
                "const": "display_pixels_orientation_normalized"
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "query_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maximum_regions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "score_threshold": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 0.99
              }
            }
          }
        ]
      },
      "SemanticGroundingResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object",
          "created_at",
          "status",
          "source_revision",
          "query_revision",
          "image",
          "regions",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "vision.semantic_grounding"
          },
          "created_at": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "const": "completed"
          },
          "source_revision": {
            "type": "string"
          },
          "query_revision": {
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/ImageGeometry"
          },
          "regions": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "region_id",
                "score",
                "bounding_box"
              ],
              "properties": {
                "region_id": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "bounding_box": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          },
          "provenance": {
            "$ref": "#/components/schemas/VisionProvenance"
          }
        }
      },
      "VisionImageFormBase": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^infer\\.": {
            "type": "string"
          }
        },
        "required": [
          "model",
          "image",
          "source_revision"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "format": "binary",
            "description": "JPEG/PNG, 1 byte through 20 MiB; decoded images are bounded to 40 megapixels"
          },
          "source_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "metadata": {
            "type": "string",
            "description": "JSON object whose values are strings; Runtime forces local_only, offline_required=true, fallback=none"
          }
        }
      },
      "VisionProvenance": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "job_id",
          "provider",
          "deployment",
          "model_build",
          "artifact_sha256",
          "preprocessing_identity",
          "postprocessing_identity",
          "runtime",
          "requested_execution_provider",
          "actual_execution_provider",
          "precision"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "deployment": {
            "type": "string"
          },
          "model_build": {
            "type": "string"
          },
          "artifact_sha256": {
            "type": "string"
          },
          "preprocessing_identity": {
            "type": "string"
          },
          "postprocessing_identity": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          },
          "requested_execution_provider": {
            "type": "string"
          },
          "actual_execution_provider": {
            "type": "string"
          },
          "execution_provider_fallback_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "precision": {
            "type": "string"
          }
        }
      }
    }
  }
}
