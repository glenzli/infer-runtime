{
  "openapi": "3.1.0",
  "info": {
    "title": "Infer Runtime capability infer.audio.transcription",
    "version": "20260811.1",
    "description": "Immutable capability-scoped wire schema. Authentication and Consumer Core negotiation are inherited from the Core contract."
  },
  "x-infer-capability-contract": "infer.audio.transcription@20260811.1",
  "paths": {
    "/v1/audio/transcriptions": {
      "post": {
        "operationId": "createTranscription",
        "parameters": [
          {
            "$ref": "#/components/parameters/TranscriptionCapability"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/TranscriptionForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transcription result; text/plain is used when response_format=text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptionResponse"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TranscriptionCapability": {
        "name": "Infer-Capability-Contract",
        "in": "header",
        "required": true,
        "schema": {
          "const": "infer.audio.transcription@20260811.1"
        }
      }
    },
    "schemas": {
      "TranscriptionForm": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^infer\\.": {
            "type": "string"
          }
        },
        "required": [
          "model",
          "file"
        ],
        "properties": {
          "model": {
            "const": "audio.transcribe"
          },
          "file": {
            "type": "string",
            "format": "binary"
          },
          "language": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "response_format": {
            "enum": [
              "json",
              "text",
              "verbose_json"
            ]
          },
          "temperature": {
            "type": "number",
            "minimum": 0
          },
          "metadata": {
            "type": "string",
            "description": "JSON object whose values are strings"
          }
        }
      },
      "TranscriptionResponse": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "model",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "const": "audio.transcribe"
          },
          "text": {
            "type": "string"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "segments": {},
          "usage": {}
        }
      }
    }
  }
}
