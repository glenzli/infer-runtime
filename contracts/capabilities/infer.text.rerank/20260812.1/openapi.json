{
  "openapi": "3.1.0",
  "info": {
    "title": "Infer Runtime capability infer.text.rerank",
    "version": "20260812.1",
    "description": "Immutable capability-scoped wire schema. Authentication and Consumer Core negotiation are inherited from the Core contract."
  },
  "x-infer-capability-contract": "infer.text.rerank@20260812.1",
  "paths": {
    "/infer/v1/text/rerank": {
      "post": {
        "operationId": "rerankDocuments",
        "x-infer-stability": "experimental",
        "parameters": [
          {
            "$ref": "#/components/parameters/RetrievalRerankCapability"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrievalRerankRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked candidate identities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrievalRerankResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "RetrievalRerankCapability": {
        "name": "Infer-Capability-Contract",
        "in": "header",
        "required": true,
        "schema": {
          "const": "infer.text.rerank@20260812.1"
        }
      }
    },
    "schemas": {
      "Metadata": {
        "type": "object",
        "default": {},
        "additionalProperties": {
          "type": "string"
        },
        "description": "Application metadata plus documented infer.* routing constraints. Unknown reserved infer.* keys are rejected."
      },
      "RetrievalProvenance": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "job_id",
          "provider",
          "deployment",
          "model_build",
          "model_revision",
          "artifact_sha256",
          "tokenizer_identity",
          "runtime",
          "precision"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "deployment": {
            "type": "string"
          },
          "model_build": {
            "type": "string"
          },
          "model_revision": {
            "type": "string"
          },
          "artifact_sha256": {
            "type": "string"
          },
          "tokenizer_identity": {
            "type": "string"
          },
          "instruction_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime": {
            "type": "string"
          },
          "precision": {
            "type": "string"
          },
          "embedding_space": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RetrievalRerankRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "query",
          "candidates"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "$ref": "#/components/schemas/RetrievalTextInput"
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/RetrievalTextInput"
            }
          },
          "top_n": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 64
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          }
        }
      },
      "RetrievalRerankResponse": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "object",
          "created_at",
          "status",
          "query_revision",
          "results",
          "score_semantics",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "query_revision": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_id",
                "source_revision",
                "score",
                "rank"
              ],
              "properties": {
                "candidate_id": {
                  "type": "string"
                },
                "source_revision": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "rank": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "score_semantics": {
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/RetrievalProvenance"
          }
        }
      },
      "RetrievalTextInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source_revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "source_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
