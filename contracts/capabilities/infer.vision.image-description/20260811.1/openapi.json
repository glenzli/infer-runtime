{
  "openapi": "3.1.0",
  "info": {
    "title": "Infer Runtime capability infer.vision.image-description",
    "version": "20260811.1",
    "description": "Immutable capability-scoped wire schema. Authentication and Consumer Core negotiation are inherited from the Core contract."
  },
  "x-infer-capability-contract": "infer.vision.image-description@20260811.1",
  "paths": {
    "/infer/v1/vision/image-descriptions": {
      "post": {
        "operationId": "createImageDescription",
        "description": "Experimental synchronous local-only typed image description. The request is not durable background payload.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ImageDescriptionCapability"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImageDescriptionForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded description and keyword proposal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageDescriptionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ImageDescriptionCapability": {
        "name": "Infer-Capability-Contract",
        "in": "header",
        "required": true,
        "schema": {
          "const": "infer.vision.image-description@20260811.1"
        }
      }
    },
    "schemas": {
      "ImageDescriptionForm": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^infer\\.": {
            "type": "string"
          }
        },
        "required": [
          "model",
          "image",
          "source_revision",
          "image_orientation",
          "language"
        ],
        "properties": {
          "model": {
            "const": "vision.describe_image"
          },
          "image": {
            "type": "string",
            "format": "binary",
            "description": "JPEG/PNG, at most 20 MiB and 40 megapixels decoded"
          },
          "source_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "image_orientation": {
            "const": "display_pixels_orientation_normalized"
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 35
          },
          "metadata": {
            "type": "string",
            "description": "JSON object whose values are strings; placement/offline/fallback are forced local-only/true/none"
          }
        }
      },
      "ImageDescriptionResponse": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "object",
          "created_at",
          "status",
          "source_revision",
          "language",
          "image",
          "result",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "vision.image_description"
          },
          "created_at": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "const": "completed"
          },
          "source_revision": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/ImageGeometry"
          },
          "result": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "description",
              "keyword_suggestions"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "keyword_suggestions": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "provenance": {
            "$ref": "#/components/schemas/ImageUnderstandingProvenance"
          }
        }
      },
      "ImageGeometry": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "width",
          "height",
          "orientation"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "orientation": {
            "const": "display_pixels_orientation_normalized"
          }
        }
      },
      "ImageUnderstandingProvenance": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "job_id",
          "provider",
          "deployment",
          "model_profile",
          "model_build",
          "physical_model",
          "runtime",
          "schema_revision",
          "prompt_revision"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "deployment": {
            "type": "string"
          },
          "model_profile": {
            "type": "string"
          },
          "model_build": {
            "type": "string"
          },
          "physical_model": {
            "type": "string"
          },
          "runtime": {
            "const": "ollama_native_chat"
          },
          "schema_revision": {
            "type": "string"
          },
          "prompt_revision": {
            "type": "string"
          },
          "total_duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "load_duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "prompt_eval_count": {
            "type": "integer",
            "minimum": 0
          },
          "eval_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
