{
  "openapi": "3.1.0",
  "info": {
    "title": "Infer Runtime capability infer.vision.image-completion",
    "version": "20260830.1",
    "description": "Immutable capability-scoped wire schema. Authentication and Consumer Core negotiation are inherited from the Core contract."
  },
  "x-infer-capability-contract": "infer.vision.image-completion@20260830.1",
  "paths": {
    "/infer/v1/vision/image-completions": {
      "post": {
        "operationId": "createImageCompletion",
        "x-infer-stability": "experimental",
        "description": "Local-only masked image completion. Runtime preserves submitted image pixels outside the submitted mask and returns one bounded 512x512 working raster.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ImageCompletionCapability"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImageCompletionForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mask-bounded completed PNG raster",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageCompletionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ImageCompletionCapability": {
        "name": "Infer-Capability-Contract",
        "in": "header",
        "required": true,
        "schema": {
          "const": "infer.vision.image-completion@20260830.1"
        }
      }
    },
    "schemas": {
      "EncodedCompletedRaster": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_type",
          "encoding",
          "data_base64",
          "sha256",
          "width",
          "height"
        ],
        "properties": {
          "content_type": {
            "const": "image/png"
          },
          "encoding": {
            "const": "srgb_rgb8_png_mask_bounded_v1"
          },
          "data_base64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 22369624
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "const": 512
          },
          "height": {
            "const": 512
          }
        }
      },
      "ImageCompletionForm": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VisionImageFormBase"
          },
          {
            "type": "object",
            "required": [
              "mask",
              "mask_revision",
              "image_orientation"
            ],
            "properties": {
              "model": {
                "const": "vision.complete_image"
              },
              "mask": {
                "type": "string",
                "format": "binary",
                "description": "PNG mask matching the submitted image extent; 1 byte through 16 MiB"
              },
              "mask_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "image_orientation": {
                "const": "display_pixels_orientation_normalized"
              }
            }
          }
        ]
      },
      "ImageCompletionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object",
          "created_at",
          "status",
          "source_revision",
          "mask_revision",
          "input_coordinate_extent",
          "raster",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "vision.image_completion"
          },
          "created_at": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "const": "completed"
          },
          "source_revision": {
            "type": "string"
          },
          "mask_revision": {
            "type": "string"
          },
          "input_coordinate_extent": {
            "$ref": "#/components/schemas/ImageGeometry"
          },
          "raster": {
            "$ref": "#/components/schemas/EncodedCompletedRaster"
          },
          "provenance": {
            "$ref": "#/components/schemas/VisionProvenance"
          }
        }
      },
      "ImageGeometry": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "width",
          "height",
          "orientation"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "orientation": {
            "const": "display_pixels_orientation_normalized"
          }
        }
      },
      "VisionImageFormBase": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^infer\\.": {
            "type": "string"
          }
        },
        "required": [
          "model",
          "image",
          "source_revision"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "format": "binary",
            "description": "JPEG/PNG, 1 byte through 20 MiB; decoded images are bounded to 40 megapixels"
          },
          "source_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "metadata": {
            "type": "string",
            "description": "JSON object whose values are strings; Runtime forces local_only, offline_required=true, fallback=none"
          }
        }
      },
      "VisionProvenance": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "job_id",
          "provider",
          "deployment",
          "model_build",
          "artifact_sha256",
          "preprocessing_identity",
          "postprocessing_identity",
          "runtime",
          "requested_execution_provider",
          "actual_execution_provider",
          "precision"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "deployment": {
            "type": "string"
          },
          "model_build": {
            "type": "string"
          },
          "artifact_sha256": {
            "type": "string"
          },
          "preprocessing_identity": {
            "type": "string"
          },
          "postprocessing_identity": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          },
          "requested_execution_provider": {
            "type": "string"
          },
          "actual_execution_provider": {
            "type": "string"
          },
          "execution_provider_fallback_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "precision": {
            "type": "string"
          }
        }
      }
    }
  }
}
