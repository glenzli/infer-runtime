{
  "paths": {
    "/infer/v1/agent/tasks": {
      "post": {
        "operationId": "createAgentTask",
        "summary": "Submit a bounded file-bearing Agent task (currently unavailable until isolation is verified)",
        "security": [{"bearerAuth": [], "consumerContract": []}],
        "parameters": [
          {"$ref": "#/components/parameters/ConsumerContract"},
          {"$ref": "#/components/parameters/AgentTaskCapability"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentTaskRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Reserved success receipt after isolated execution is enabled",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentTaskResult"}}}
          },
          "403": {
            "description": "App lacks independent Agent task ACL",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentTaskError"}}}
          },
          "503": {
            "description": "Executor isolation and approval boundary are not verified",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentTaskError"}}}
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AgentTaskCapability": {
        "name": "Infer-Capability-Contract",
        "in": "header",
        "required": true,
        "schema": {"type": "string", "const": "infer.agent.task@20260925.1"}
      }
    },
    "schemas": {
      "AgentTaskInputFile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_base64", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$", "description": "ASCII relative path beneath private input/ or output/; no host path or parent traversal; case-insensitive duplicates rejected"},
          "content_base64": {"type": "string", "contentEncoding": "base64", "description": "At most 8 MiB decoded per input file"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "AgentTaskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "instruction", "input_files", "output_paths"],
        "properties": {
          "model": {"type": "string", "const": "agent.file_task"},
          "instruction": {"type": "string", "minLength": 1, "maxLength": 16384},
          "input_files": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/components/schemas/AgentTaskInputFile"}},
          "output_paths": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$"}}
        }
      },
      "AgentTaskProvenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_contract", "provider", "deployment", "model_build", "attempt_number", "codex_thread_id", "codex_turn_id", "sandbox_profile", "tool_policy"],
        "properties": {
          "capability_contract": {"type": "string", "const": "infer.agent.task@20260925.1"},
          "provider": {"type": "string"},
          "deployment": {"type": "string"},
          "model_build": {"type": "string"},
          "attempt_number": {"type": "integer", "minimum": 1},
          "codex_thread_id": {"type": "string"},
          "codex_turn_id": {"type": "string"},
          "sandbox_profile": {"type": "string"},
          "tool_policy": {"type": "string"}
        }
      },
      "AgentTaskResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "state", "answer", "outputs", "provenance"],
        "properties": {
          "job_id": {"type": "string"},
          "state": {"type": "string", "const": "completed"},
          "answer": {"type": "string"},
          "outputs": {"type": "array", "maxItems": 16, "items": {"$ref": "#/components/schemas/AgentTaskInputFile"}},
          "provenance": {"$ref": "#/components/schemas/AgentTaskProvenance"}
        }
      },
      "AgentTaskError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["message", "type", "code"],
            "properties": {
              "message": {"type": "string"},
              "type": {"type": "string", "const": "invalid_request_error"},
              "code": {"type": "string", "enum": ["agent_task_forbidden", "agent_task_unavailable"]}
            }
          }
        }
      }
    }
  }
}
